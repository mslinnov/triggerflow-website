<mjml><mj-head><!-- VISIBILITY_STYLES --><mj-style>
      /* Desktop-first : les clients qui ne supportent pas @media
         (Outlook Web, Nouveau Outlook) gardent le comportement desktop. */
      .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
        display: block;
        width: auto;
        max-height: none;
        overflow: visible;
        line-height: inherit;
      }
      .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
        display: none;
        width: 0;
        max-height: 0;
        overflow: hidden;
        line-height: 0;
      }
      /* Mobile : afficher mobile-only, masquer desktop-only */
      @media only screen and (max-width:599px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
      }
      /* Desktop explicit (pour spécificité) */
      @media only screen and (min-width:600px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
      /* Fallback : vrais appareils mobiles (Outlook mobile peut avoir un viewport &gt;600px) */
      @media only screen and (max-device-width:599px) {
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
    </mj-style><!--[if mso | IE]>
      <style type="text/css">
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        table.desktop-only, table.desktop-only-outlook, table[class*="desktop-only"],
        tr.desktop-only, tr.desktop-only-outlook, tr[class*="desktop-only"],
        td.desktop-only, td.desktop-only-outlook, td[class*="desktop-only"] {
          display: table !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        table.mobile-only, table.mobile-only-outlook, table[class*="mobile-only"],
        tr.mobile-only, tr.mobile-only-outlook, tr[class*="mobile-only"],
        td.mobile-only, td.mobile-only-outlook, td[class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      </style>
    <![endif]--><mj-attributes><mj-all padding="0">
            </mj-all></mj-attributes><mj-preview>Le cadeau de Noël idéal, réglé avant même décembre.</mj-preview></mj-head><mj-body background-color="#F4F4F4" width="640px"><mj-section background-color="#FFFFFF" padding="28px 20px 8px 20px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="24px" letter-spacing="3px" color="#2B2B2B" padding="0 0 14px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-divider border-width="1px" border-color="#E2E2E2" padding="0 60px"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" line-height="20px" letter-spacing="1px" color="#2B2B2B" padding="12px 0 6px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{website_url}}" style="color:#2B2B2B;text-decoration:none;">Chambres</a><span style="color:#6F6F6F;">&nbsp;· </span><a href="{{website_url}}" style="color:#2B2B2B;text-decoration:none;">Restaurant</a><span style="color:#6F6F6F;">&nbsp;· </span><a href="{{website_url}}" style="color:#2B2B2B;text-decoration:none;">Bons&nbsp;cadeaux</a><span style="color:#6F6F6F;">&nbsp;· </span><a href="{{booking_page_url}}" style="color:#2B2B2B;text-decoration:none;">Réserver</a></p></mj-text></mj-column></mj-section><mj-hero mode="fixed-height" height="440px" background-width="640px" background-height="440px" background-url="https://api.trigger-flow.com/storage/files/file_694267060e1ee.webp" background-color="#2B2B2B" background-position="center center" padding="150px 40px 40px 40px"><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="12px" letter-spacing="4px" color="#FFFFFF" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;text-shadow:0 1px 6px rgba(0,0,0,0.6);">Black Friday</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="34px" line-height="40px" color="#FFFFFF" padding="0 0 24px 0"><p style="margin:0;"><span style="background-color:rgba(0,0,0,0.38);padding:4px 14px;line-height:52px;-webkit-box-decoration-break:clone;box-decoration-break:clone;text-shadow:0 2px 10px rgba(0,0,0,0.5);">Nos bons cadeaux à prix doux</span></p></mj-text><mj-button href="[[Lien de votre boutique de bons cadeaux|{{website_url}}]]" background-color="#FFFFFF" color="#2B2B2B" border-radius="40px" font-family="Helvetica, Arial, sans-serif" font-size="12px" font-weight="bold" letter-spacing="2px" text-transform="uppercase" inner-padding="14px 30px" padding="0">Choisir un bon cadeau</mj-button></mj-hero><mj-section background-color="#FFFFFF" padding="40px 48px 16px 48px"><mj-column><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="16px" line-height="26px" color="#2B2B2B" padding="0"><p style="margin:0 0 14px 0;">Bonjour {{firstname}},</p><p style="margin:0 0 14px 0;">Pendant [[Durée de l'offre|4 jours]], jusqu'au [[Fin de l'offre|dimanche minuit]], tous nos bons cadeaux sont à [[Réduction|-20 %]]. Un cadeau de Noël qui fait plaisir, réglé avant même décembre.</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="16px 32px 0 32px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="26px" line-height="32px" color="#2B2B2B" padding="0 0 18px 0"><p style="margin:0;">Trois idées à offrir</p></mj-text></mj-column></mj-section><mj-section background-color="#EAD7CE" padding="24px 24px 8px 24px"><mj-column width="33.33%" padding="0 8px 16px 8px"><mj-text align="center" container-background-color="#FFFFFF" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="26px" color="#7A2E3A" padding="22px 14px 8px 14px"><p style="margin:0;">Une nuit pour deux</p></mj-text><mj-text align="center" container-background-color="#FFFFFF" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#2B2B2B" padding="0 16px 12px 16px"><p style="margin:0;">[[Ce qui est compris|Chambre et petit-déjeuner]]</p></mj-text><mj-text align="center" container-background-color="#FFFFFF" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="20px" color="#6F6F6F" padding="0 14px 16px 14px"><p style="margin:0;">[[Prix remisé|180 €]] au lieu de [[Prix habituel|225 €]]</p></mj-text><mj-button href="[[Lien de votre boutique de bons cadeaux|{{website_url}}]]" background-color="#FFFFFF" container-background-color="#FFFFFF" color="#7A2E3A" border="1px solid #7A2E3A" border-radius="0px" font-family="Helvetica, Arial, sans-serif" font-size="11px" font-weight="bold" letter-spacing="2px" text-transform="uppercase" inner-padding="11px 18px" padding="0 14px 24px 14px">Offrir</mj-button></mj-column><mj-column width="33.33%" padding="0 8px 16px 8px"><mj-text align="center" container-background-color="#FFFFFF" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="26px" color="#7A2E3A" padding="22px 14px 8px 14px"><p style="margin:0;">Un dîner</p></mj-text><mj-text align="center" container-background-color="#FFFFFF" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#2B2B2B" padding="0 16px 12px 16px"><p style="margin:0;">[[Ce qui est compris|Menu du chef pour deux, accord mets et vins]]</p></mj-text><mj-text align="center" container-background-color="#FFFFFF" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="20px" color="#6F6F6F" padding="0 14px 16px 14px"><p style="margin:0;">[[Prix remisé|120 €]] au lieu de [[Prix habituel|150 €]]</p></mj-text><mj-button href="[[Lien de votre boutique de bons cadeaux|{{website_url}}]]" background-color="#FFFFFF" container-background-color="#FFFFFF" color="#7A2E3A" border="1px solid #7A2E3A" border-radius="0px" font-family="Helvetica, Arial, sans-serif" font-size="11px" font-weight="bold" letter-spacing="2px" text-transform="uppercase" inner-padding="11px 18px" padding="0 14px 24px 14px">Offrir</mj-button></mj-column><mj-column width="33.33%" padding="0 8px 16px 8px"><mj-text align="center" container-background-color="#FFFFFF" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="26px" color="#7A2E3A" padding="22px 14px 8px 14px"><p style="margin:0;">Un moment de détente</p></mj-text><mj-text align="center" container-background-color="#FFFFFF" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#2B2B2B" padding="0 16px 12px 16px"><p style="margin:0;">[[Ce qui est compris|Accès au spa et soin de 50 minutes]]</p></mj-text><mj-text align="center" container-background-color="#FFFFFF" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="20px" color="#6F6F6F" padding="0 14px 16px 14px"><p style="margin:0;">[[Prix remisé|72 €]] au lieu de [[Prix habituel|90 €]]</p></mj-text><mj-button href="[[Lien de votre boutique de bons cadeaux|{{website_url}}]]" background-color="#FFFFFF" container-background-color="#FFFFFF" color="#7A2E3A" border="1px solid #7A2E3A" border-radius="0px" font-family="Helvetica, Arial, sans-serif" font-size="11px" font-weight="bold" letter-spacing="2px" text-transform="uppercase" inner-padding="11px 18px" padding="0 14px 24px 14px">Offrir</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="36px 32px 0 32px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="26px" line-height="32px" color="#2B2B2B" padding="0 0 18px 0"><p style="margin:0;">Simple comme un e-mail</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="8px 22px 20px 22px"><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#7A2E3A" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#2B2B2B" padding="0 0 16px 0"><p style="margin:0;"><strong>Choisir</strong> le bon et son montant</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#7A2E3A" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#2B2B2B" padding="0 0 16px 0"><p style="margin:0;"><strong>Personnaliser</strong> votre message</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#7A2E3A" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#2B2B2B" padding="0 0 16px 0"><p style="margin:0;"><strong>Offrir</strong> : il arrive par e-mail, prêt à imprimer</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="8px 48px 40px 48px"><mj-column><mj-divider border-width="1px" border-color="#E2E2E2" padding="0 0 24px 0"></mj-divider><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="17px" line-height="26px" font-style="italic" color="#2B2B2B" padding="0 0 18px 0"><p style="margin:0;">À bientôt,<br/>[[Prénom du directeur|Claire]], et toute l'équipe de {{facility_name}}</p></mj-text><mj-text font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#6F6F6F" padding="0"><p style="margin:0;"><strong style="color:#7A2E3A;">P.S.</strong> Les bons achetés pendant le Black Friday sont valables [[Durée de validité|12 mois]] : de quoi offrir un séjour au printemps comme à l'été.</p></mj-text></mj-column></mj-section><mj-section background-color="#F4F4F4" padding="32px 24px 36px 24px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="18px" letter-spacing="2px" color="#2B2B2B" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" line-height="20px" letter-spacing="1px" color="#6F6F6F" padding="0 0 12px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{booking_page_url}}" style="color:#6F6F6F;text-decoration:none;">Séjours</a>&nbsp;· <a href="{{website_url}}" style="color:#6F6F6F;text-decoration:none;">Restaurant</a>&nbsp;· <a href="{{website_url}}" style="color:#6F6F6F;text-decoration:none;">Séminaires</a>&nbsp;· <a href="{{website_url}}" style="color:#6F6F6F;text-decoration:none;">Bons&nbsp;cadeaux</a></p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="20px" color="#6F6F6F" padding="0 0 12px 0"><p style="margin:0;">{{facility_address}}, {{facility_zip_code}} {{facility_city}}<br/>{{facility_phone}} · {{facility_email}}</p></mj-text><mj-social font-size="12px" icon-size="28px" border-radius="80px" mode="horizontal" padding="4px 0 0 0"><mj-social-element name="instagram" href="{{social_instagram}}" src="https://app.trigger-flow.com/socialIcons/light/instagram.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="facebook" href="{{social_facebook}}" src="https://app.trigger-flow.com/socialIcons/light/facebook.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="tripadvisor" href="{{social_tripadvisor}}" src="https://app.trigger-flow.com/socialIcons/light/tripadvisor.png" background-color="transparent" padding="0 6px"></mj-social-element></mj-social></mj-column></mj-section></mj-body></mjml>