<mjml><mj-head><!-- VISIBILITY_STYLES --><mj-style>
      /* Desktop-first : les clients qui ne supportent pas @media
         (Outlook Web, Nouveau Outlook) gardent le comportement desktop. */
      .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
        display: block;
        width: auto;
        max-height: none;
        overflow: visible;
        line-height: inherit;
      }
      .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
        display: none;
        width: 0;
        max-height: 0;
        overflow: hidden;
        line-height: 0;
      }
      /* Mobile : afficher mobile-only, masquer desktop-only */
      @media only screen and (max-width:599px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
      }
      /* Desktop explicit (pour spécificité) */
      @media only screen and (min-width:600px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
      /* Fallback : vrais appareils mobiles (Outlook mobile peut avoir un viewport &gt;600px) */
      @media only screen and (max-device-width:599px) {
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
    </mj-style><!--[if mso | IE]>
      <style type="text/css">
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        table.desktop-only, table.desktop-only-outlook, table[class*="desktop-only"],
        tr.desktop-only, tr.desktop-only-outlook, tr[class*="desktop-only"],
        td.desktop-only, td.desktop-only-outlook, td[class*="desktop-only"] {
          display: table !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        table.mobile-only, table.mobile-only-outlook, table[class*="mobile-only"],
        tr.mobile-only, tr.mobile-only-outlook, tr[class*="mobile-only"],
        td.mobile-only, td.mobile-only-outlook, td[class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      </style>
    <![endif]--><mj-attributes><mj-all padding="0">
            </mj-all></mj-attributes><mj-preview>Deux semaines de vacances pour toutes les zones, et un programme pour les enfants.</mj-preview></mj-head><mj-body background-color="#F4F2EF" width="640px"><mj-section background-color="#1C1C1C" padding="22px 28px"><mj-column width="50%" vertical-align="middle"><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="16px" letter-spacing="4px" color="#FFFFFF" padding="4px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text></mj-column><mj-column width="50%" vertical-align="middle"><mj-text align="right" css-class="tf-band-links" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="11px" line-height="20px" letter-spacing="2px" color="#FFFFFF" padding="4px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{website_url}}" style="color:#FFFFFF;text-decoration:none;">Chambres</a><span style="color:#9A9A9A;">&nbsp;· </span><a href="{{website_url}}" style="color:#FFFFFF;text-decoration:none;">Bons&nbsp;cadeaux</a><span style="color:#9A9A9A;">&nbsp;· </span><a href="{{booking_page_url}}" style="color:#FFFFFF;text-decoration:none;">Réserver</a></p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0"><mj-column><mj-image src="https://api.trigger-flow.com/storage/files/file_694267060e1ee.webp" alt="L&#039;automne en famille" padding="0" width="640px"></mj-image></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="36px 48px 8px 48px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="12px" letter-spacing="4px" color="#7A2E3A" padding="0 0 12px 0"><p style="margin:0;text-transform:uppercase;">Vacances de la Toussaint</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="30px" line-height="38px" letter-spacing="2px" color="#1C1C1C" padding="0 0 22px 0"><p style="margin:0;text-transform:uppercase;">L'automne en famille</p></mj-text><mj-button href="{{booking_page_url}}" align="left" background-color="#1C1C1C" color="#FFFFFF" border-radius="30px" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="13px" letter-spacing="2px" text-transform="uppercase" inner-padding="13px 28px" padding="0">Réserver la Toussaint</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="40px 48px 16px 48px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="16px" line-height="26px" color="#1C1C1C" padding="0"><p style="margin:0 0 14px 0;">Bonjour {{firstname}},</p><p style="margin:0 0 14px 0;">Les vacances de la Toussaint sont les mêmes pour toutes les zones. Deux semaines pour se retrouver en famille, entre balades d'automne et soirées au chaud.</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="24px 48px 24px 48px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="28px" letter-spacing="3px" color="#1C1C1C" padding="0 0 18px 0"><p style="margin:0;text-transform:uppercase;">Les dates</p></mj-text><mj-text padding="0"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-top:1px solid #D9D9D9;"><tr><td valign="top" style="padding:14px 16px 14px 0;border-bottom:1px solid #D9D9D9;width:36%;font-family:Georgia, 'Times New Roman', serif;font-size:17px;line-height:24px;color:#1C1C1C;">Toutes les zones</td><td valign="top" style="padding:14px 0;border-bottom:1px solid #D9D9D9;font-family:Georgia, 'Times New Roman', serif;font-size:14px;line-height:22px;color:#1C1C1C;">Du [[Date de début|samedi 23 octobre]] au [[Date de fin|lundi 8 novembre]]<br/><span style="font-size:12px;color:#555555;">Zones A, B et C</span></td></tr></table></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="36px 32px 0 32px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="28px" letter-spacing="3px" color="#1C1C1C" padding="0 0 18px 0"><p style="margin:0;text-transform:uppercase;">Pour les enfants</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="8px 22px 20px 22px"><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C8B49C" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 0 16px 0"><p style="margin:0;">[[Activité|La chasse aux trésors d'automne]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C8B49C" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 0 16px 0"><p style="margin:0;">[[Activité|Le goûter au coin du feu]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C8B49C" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 0 16px 0"><p style="margin:0;">[[Activité|L'atelier citrouilles pour Halloween]]</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="28px 32px 4px 32px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="28px" letter-spacing="3px" color="#1C1C1C" padding="0 0 18px 0"><p style="margin:0;text-transform:uppercase;">La chambre familiale</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px 32px"><mj-column width="50%" vertical-align="middle" background-color="#FFFFFF" padding="14px" border="1px solid #C8B49C"><mj-image src="https://api.trigger-flow.com/storage/files/file_M9suoBoTcQoweZdx.png" alt="Tout le monde à son aise" padding="0" width="260px"></mj-image></mj-column><mj-column width="50%" vertical-align="middle" padding="12px 24px"><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="12px" letter-spacing="3px" color="#7A2E3A" padding="0 0 8px 0"><p style="margin:0;text-transform:uppercase;">Tout le monde à son aise</p></mj-text><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="22px" color="#1C1C1C" padding="0"><p style="margin:0;">[[Votre chambre familiale|Chambres communicantes, lit bébé sur demande, menu enfant au restaurant.]] Réservez en direct : [[Votre avantage|le petit-déjeuner offert aux enfants]].</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="8px 48px 40px 48px"><mj-column><mj-divider border-width="1px" border-color="#D9D9D9" padding="0 0 24px 0"></mj-divider><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="17px" line-height="26px" font-style="italic" color="#1C1C1C" padding="0 0 18px 0"><p style="margin:0;">Bel automne,<br/>[[Prénom du directeur|Claire]], et toute l'équipe de {{facility_name}}</p></mj-text><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="22px" color="#555555" padding="0"><p style="margin:0;"><strong style="color:#7A2E3A;">P.S.</strong> Halloween tombe pendant les vacances : [[Votre animation|soirée costumée et dîner des petits monstres]] le 31 octobre.</p></mj-text></mj-column></mj-section><mj-section background-color="#F4F2EF" padding="32px 24px 36px 24px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="18px" letter-spacing="2px" color="#1C1C1C" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="11px" line-height="20px" letter-spacing="1px" color="#555555" padding="0 0 12px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{booking_page_url}}" style="color:#555555;text-decoration:none;">Séjours</a>&nbsp;· <a href="{{website_url}}" style="color:#555555;text-decoration:none;">Restaurant</a>&nbsp;· <a href="{{website_url}}" style="color:#555555;text-decoration:none;">Séminaires</a>&nbsp;· <a href="{{website_url}}" style="color:#555555;text-decoration:none;">Bons&nbsp;cadeaux</a></p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="13px" line-height="20px" color="#555555" padding="0 0 12px 0"><p style="margin:0;">{{facility_address}}, {{facility_zip_code}} {{facility_city}}<br/>{{facility_phone}} · {{facility_email}}</p></mj-text><mj-social font-size="12px" icon-size="28px" border-radius="80px" mode="horizontal" padding="4px 0 0 0"><mj-social-element name="instagram" href="{{social_instagram}}" src="https://app.trigger-flow.com/socialIcons/light/instagram.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="facebook" href="{{social_facebook}}" src="https://app.trigger-flow.com/socialIcons/light/facebook.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="tripadvisor" href="{{social_tripadvisor}}" src="https://app.trigger-flow.com/socialIcons/light/tripadvisor.png" background-color="transparent" padding="0 6px"></mj-social-element></mj-social></mj-column></mj-section></mj-body></mjml>