<mjml><mj-head><!-- VISIBILITY_STYLES --><mj-style>
      /* Desktop-first : les clients qui ne supportent pas @media
         (Outlook Web, Nouveau Outlook) gardent le comportement desktop. */
      .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
        display: block;
        width: auto;
        max-height: none;
        overflow: visible;
        line-height: inherit;
      }
      .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
        display: none;
        width: 0;
        max-height: 0;
        overflow: hidden;
        line-height: 0;
      }
      /* Mobile : afficher mobile-only, masquer desktop-only */
      @media only screen and (max-width:599px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
      }
      /* Desktop explicit (pour spécificité) */
      @media only screen and (min-width:600px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
      /* Fallback : vrais appareils mobiles (Outlook mobile peut avoir un viewport &gt;600px) */
      @media only screen and (max-device-width:599px) {
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
    </mj-style><!--[if mso | IE]>
      <style type="text/css">
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        table.desktop-only, table.desktop-only-outlook, table[class*="desktop-only"],
        tr.desktop-only, tr.desktop-only-outlook, tr[class*="desktop-only"],
        td.desktop-only, td.desktop-only-outlook, td[class*="desktop-only"] {
          display: table !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        table.mobile-only, table.mobile-only-outlook, table[class*="mobile-only"],
        tr.mobile-only, tr.mobile-only-outlook, tr[class*="mobile-only"],
        td.mobile-only, td.mobile-only-outlook, td[class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      </style>
    <![endif]--><mj-attributes><mj-all padding="0">
            </mj-all></mj-attributes><mj-preview>Repas, séminaire ou soirée : trois formats, un seul interlocuteur.</mj-preview></mj-head><mj-body background-color="#F4F2EF" width="640px"><mj-section background-color="#1C1C1C" padding="22px 28px"><mj-column width="50%" vertical-align="middle"><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="16px" letter-spacing="4px" color="#FFFFFF" padding="4px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text></mj-column><mj-column width="50%" vertical-align="middle"><mj-text align="right" css-class="tf-band-links" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="11px" line-height="20px" letter-spacing="2px" color="#FFFFFF" padding="4px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{website_url}}" style="color:#FFFFFF;text-decoration:none;">Chambres</a><span style="color:#9A9A9A;">&nbsp;· </span><a href="{{website_url}}" style="color:#FFFFFF;text-decoration:none;">Bons&nbsp;cadeaux</a><span style="color:#9A9A9A;">&nbsp;· </span><a href="{{booking_page_url}}" style="color:#FFFFFF;text-decoration:none;">Réserver</a></p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0"><mj-column><mj-image src="https://api.trigger-flow.com/storage/files/file_o5SD5L3pcUlhVjds.png" alt="Votre fin d&#039;année, organisée sans stress" padding="0" width="640px"></mj-image></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="36px 48px 8px 48px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="12px" letter-spacing="4px" color="#7A2E3A" padding="0 0 12px 0"><p style="margin:0;text-transform:uppercase;">Entreprises</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="30px" line-height="38px" letter-spacing="2px" color="#1C1C1C" padding="0 0 22px 0"><p style="margin:0;text-transform:uppercase;">Votre fin d'année, organisée sans stress</p></mj-text><mj-button href="[[Lien de votre demande de devis|{{website_url}}]]" align="left" background-color="#1C1C1C" color="#FFFFFF" border-radius="30px" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="13px" letter-spacing="2px" text-transform="uppercase" inner-padding="13px 28px" padding="0">Demander un devis</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="40px 48px 16px 48px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="16px" line-height="26px" color="#1C1C1C" padding="0"><p style="margin:0 0 14px 0;">Bonjour {{firstname}},</p><p style="margin:0 0 14px 0;">Repas d'équipe, séminaire de bilan ou soirée de fin d'année : nous organisons votre événement de bout en bout, chambres comprises. Vous choisissez le format, on s'occupe du reste.</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="28px 38px 4px 38px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="28px" letter-spacing="3px" color="#1C1C1C" padding="0 0 18px 0"><p style="margin:0;text-transform:uppercase;">Trois formats, à votre mesure</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 28px"><mj-column width="50%" padding="0 10px 22px 10px" background-color="#FFFFFF"><mj-image src="https://api.trigger-flow.com/storage/files/file_M9suoBoTcQoweZdx.png" alt="Le repas d&#039;équipe" padding="0"></mj-image><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="19px" line-height="26px" color="#1C1C1C" padding="16px 16px 6px 16px"><p style="margin:0;text-transform:uppercase;letter-spacing:2px;">Le repas d'équipe</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 16px 8px 16px"><p style="margin:0;">[[Ce qui est compris|Déjeuner ou dîner en salle privée, menu du chef et boissons]]</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="13px" line-height="20px" color="#555555" padding="0 16px 10px 16px"><p style="margin:0;">Jusqu'à [[Capacité|60]] personnes</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="12px" letter-spacing="2px" padding="0 16px 20px 16px"><p style="margin:0;text-transform:uppercase;"><a href="[[Lien de votre demande de devis|{{website_url}}]]" style="color:#1C1C1C;text-decoration:underline;">Demander un devis</a></p></mj-text></mj-column><mj-column width="50%" padding="0 10px 22px 10px" background-color="#FFFFFF"><mj-image src="https://api.trigger-flow.com/storage/files/file_694267060e1ee.webp" alt="Le séminaire" padding="0"></mj-image><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="19px" line-height="26px" color="#1C1C1C" padding="16px 16px 6px 16px"><p style="margin:0;text-transform:uppercase;letter-spacing:2px;">Le séminaire</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 16px 8px 16px"><p style="margin:0;">[[Ce qui est compris|Salle équipée, pauses gourmandes et déjeuner]]</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="13px" line-height="20px" color="#555555" padding="0 16px 10px 16px"><p style="margin:0;">Jusqu'à [[Capacité|40]] personnes</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="12px" letter-spacing="2px" padding="0 16px 20px 16px"><p style="margin:0;text-transform:uppercase;"><a href="[[Lien de votre demande de devis|{{website_url}}]]" style="color:#1C1C1C;text-decoration:underline;">Demander un devis</a></p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 38px 22px 38px"><mj-column width="50%" vertical-align="middle" background-color="#FFFFFF"><mj-image src="https://api.trigger-flow.com/storage/files/file_f7oUtrNK7XJ16kbf.png" alt="La soirée" padding="0"></mj-image></mj-column><mj-column width="50%" vertical-align="middle" background-color="#FFFFFF" padding="8px 0"><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="19px" line-height="26px" color="#1C1C1C" padding="16px 16px 6px 16px"><p style="margin:0;text-transform:uppercase;letter-spacing:2px;">La soirée</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 16px 8px 16px"><p style="margin:0;">[[Ce qui est compris|Cocktail, dîner placé et animation musicale]]</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="13px" line-height="20px" color="#555555" padding="0 16px 10px 16px"><p style="margin:0;">Jusqu'à [[Capacité|120]] personnes</p></mj-text><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="12px" letter-spacing="2px" padding="0 16px 20px 16px"><p style="margin:0;text-transform:uppercase;"><a href="[[Lien de votre demande de devis|{{website_url}}]]" style="color:#1C1C1C;text-decoration:underline;">Demander un devis</a></p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="36px 32px 0 32px"><mj-column><mj-text align="left" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="20px" line-height="28px" letter-spacing="3px" color="#1C1C1C" padding="0 0 18px 0"><p style="margin:0;text-transform:uppercase;">Ce que nous prenons en charge</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="8px 22px 20px 22px"><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C8B49C" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 0 16px 0"><p style="margin:0;">[[Avantage|Un interlocuteur unique, du devis à la facture]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C8B49C" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 0 16px 0"><p style="margin:0;">[[Avantage|Des chambres à tarif préférentiel pour vos équipes]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C8B49C" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="21px" color="#1C1C1C" padding="0 0 16px 0"><p style="margin:0;">Votre devis sous [[Délai du devis|48 h]]</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="8px 48px 40px 48px"><mj-column><mj-divider border-width="1px" border-color="#D9D9D9" padding="0 0 24px 0"></mj-divider><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="17px" line-height="26px" font-style="italic" color="#1C1C1C" padding="0 0 18px 0"><p style="margin:0;">À votre écoute,<br/>[[Prénom du responsable des événements|Thomas]], et toute l'équipe de {{facility_name}}</p></mj-text><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="14px" line-height="22px" color="#555555" padding="0"><p style="margin:0;"><strong style="color:#7A2E3A;">P.S.</strong> Les dates de décembre partent vite : réservez avant le [[Date limite|15 octobre]].</p></mj-text></mj-column></mj-section><mj-section background-color="#F4F2EF" padding="32px 24px 36px 24px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="18px" letter-spacing="2px" color="#1C1C1C" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="11px" line-height="20px" letter-spacing="1px" color="#555555" padding="0 0 12px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{booking_page_url}}" style="color:#555555;text-decoration:none;">Séjours</a>&nbsp;· <a href="{{website_url}}" style="color:#555555;text-decoration:none;">Restaurant</a>&nbsp;· <a href="{{website_url}}" style="color:#555555;text-decoration:none;">Séminaires</a>&nbsp;· <a href="{{website_url}}" style="color:#555555;text-decoration:none;">Bons&nbsp;cadeaux</a></p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="13px" line-height="20px" color="#555555" padding="0 0 12px 0"><p style="margin:0;">{{facility_address}}, {{facility_zip_code}} {{facility_city}}<br/>{{facility_phone}} · {{facility_email}}</p></mj-text><mj-social font-size="12px" icon-size="28px" border-radius="80px" mode="horizontal" padding="4px 0 0 0"><mj-social-element name="instagram" href="{{social_instagram}}" src="https://app.trigger-flow.com/socialIcons/light/instagram.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="facebook" href="{{social_facebook}}" src="https://app.trigger-flow.com/socialIcons/light/facebook.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="tripadvisor" href="{{social_tripadvisor}}" src="https://app.trigger-flow.com/socialIcons/light/tripadvisor.png" background-color="transparent" padding="0 6px"></mj-social-element></mj-social></mj-column></mj-section></mj-body></mjml>