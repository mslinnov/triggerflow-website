<mjml><mj-head><!-- VISIBILITY_STYLES --><mj-style>
      /* Desktop-first : les clients qui ne supportent pas @media
         (Outlook Web, Nouveau Outlook) gardent le comportement desktop. */
      .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
        display: block;
        width: auto;
        max-height: none;
        overflow: visible;
        line-height: inherit;
      }
      .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
        display: none;
        width: 0;
        max-height: 0;
        overflow: hidden;
        line-height: 0;
      }
      /* Mobile : afficher mobile-only, masquer desktop-only */
      @media only screen and (max-width:599px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
      }
      /* Desktop explicit (pour spécificité) */
      @media only screen and (min-width:600px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
      /* Fallback : vrais appareils mobiles (Outlook mobile peut avoir un viewport &gt;600px) */
      @media only screen and (max-device-width:599px) {
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
    </mj-style><!--[if mso | IE]>
      <style type="text/css">
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        table.desktop-only, table.desktop-only-outlook, table[class*="desktop-only"],
        tr.desktop-only, tr.desktop-only-outlook, tr[class*="desktop-only"],
        td.desktop-only, td.desktop-only-outlook, td[class*="desktop-only"] {
          display: table !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        table.mobile-only, table.mobile-only-outlook, table[class*="mobile-only"],
        tr.mobile-only, tr.mobile-only-outlook, tr[class*="mobile-only"],
        td.mobile-only, td.mobile-only-outlook, td[class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      </style>
    <![endif]--><mj-attributes><mj-all padding="0">
            </mj-all></mj-attributes><mj-preview>Les dates de votre zone, et tout ce qu'il faut pour les enfants.</mj-preview></mj-head><mj-body background-color="#E9E6E0" width="640px"><mj-section background-color="#FFFFFF" padding="36px 24px 0 24px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="26px" line-height="32px" letter-spacing="5px" color="#1E1E1E" padding="0 0 24px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-divider border-width="1px" border-color="#DDD9D2" padding="0"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" line-height="20px" letter-spacing="2px" color="#1E1E1E" padding="11px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{booking_page_url}}" style="color:#1E1E1E;text-decoration:none;">Réserver</a><span style="color:#8C6B4A;">&nbsp;&nbsp;·&nbsp; </span><a href="{{website_url}}" style="color:#1E1E1E;text-decoration:none;">Nos&nbsp;offres</a><span style="color:#8C6B4A;">&nbsp;&nbsp;·&nbsp; </span><a href="{{website_url}}" style="color:#1E1E1E;text-decoration:none;">L'hôtel</a></p></mj-text><mj-divider border-width="1px" border-color="#DDD9D2" padding="0"></mj-divider></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="28px 40px 0 40px"><mj-group><mj-column width="33.33%" padding="0 5px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/breakfast-600.jpg" href="{{booking_page_url}}" alt="Le printemps en famille" padding="0"></mj-image></mj-column><mj-column width="33.33%" padding="0 5px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/sea-terrace-600.jpg" href="{{booking_page_url}}" alt="Le printemps en famille" padding="0"></mj-image></mj-column><mj-column width="33.33%" padding="0 5px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/spa-600.jpg" href="{{booking_page_url}}" alt="Le printemps en famille" padding="0"></mj-image></mj-column></mj-group></mj-section><mj-section background-color="#FFFFFF" padding="48px 56px 52px 56px"><mj-column><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" letter-spacing="4px" color="#8C6B4A" padding="0 0 14px 0"><p style="margin:0;text-transform:uppercase;">Vacances de printemps</p></mj-text><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="30px" line-height="38px" color="#1E1E1E" padding="0 0 20px 0"><p style="margin:0;">Le printemps en famille</p></mj-text><mj-divider width="48px" border-width="1px" border-color="#8C6B4A" padding="0 0 22px 0"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="15px" line-height="25px" color="#474747" padding="0 0 14px 0"><p style="margin:0 0 12px 0;">Bonjour {{firstname}},</p><p style="margin:0 0 12px 0;">Les vacances de printemps arrivent, à des dates différentes selon votre zone. Chambres familiales, activités pour les enfants : tout est prêt, il ne manque que vous.</p></mj-text><mj-button href="{{booking_page_url}}" background-color="#8C6B4A" color="#FFFFFF" border-radius="0px" font-family="Helvetica, Arial, sans-serif" font-size="12px" letter-spacing="3px" text-transform="uppercase" inner-padding="16px 40px" padding="0">Voir les disponibilités</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 56px 26px 56px"><mj-column><mj-divider border-width="1px" border-color="#DDD9D2" padding="0 0 40px 0"></mj-divider><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="24px" line-height="30px" color="#1E1E1E" padding="0"><p style="margin:0;">Pour toute la famille</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 30px 8px 30px"><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/sea-room-600.jpg" href="{{booking_page_url}}" alt="La chambre familiale" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">La chambre familiale</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Votre chambre familiale|Jusqu'à quatre personnes]]</p></mj-text></mj-column><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/pool-square-600.jpg" href="{{booking_page_url}}" alt="La piscine" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">La piscine</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Activité|Chauffée]]</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 30px 8px 30px"><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/kids-600.jpg" href="{{booking_page_url}}" alt="Le goûter" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">Le goûter</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Activité|Offert chaque après-midi]]</p></mj-text></mj-column><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/restaurant-600.jpg" href="{{booking_page_url}}" alt="Le restaurant" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">Le restaurant</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Activité|Menu enfant]]</p></mj-text></mj-column></mj-section><mj-section background-color="#F6F4F0" padding="40px 56px 40px 56px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="21px" line-height="28px" color="#1E1E1E" padding="0 0 26px 0"><p style="margin:0;">Les dates de votre zone</p></mj-text><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="18px" line-height="25px" color="#1E1E1E" padding="0 0 4px 0"><p style="margin:0;">Zone A</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#474747" padding="0"><p style="margin:0;">Du [[Dates de la zone A|10 au 26 avril]]<br/><span style="font-size:12px;color:#7A7A7A;">Lyon, Bordeaux, Grenoble, Dijon…</span></p></mj-text><mj-divider width="40px" border-width="1px" border-color="#DDD9D2" padding="18px 0"></mj-divider><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="18px" line-height="25px" color="#1E1E1E" padding="0 0 4px 0"><p style="margin:0;">Zone B</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#474747" padding="0"><p style="margin:0;">Du [[Dates de la zone B|17 avril au 3 mai]]<br/><span style="font-size:12px;color:#7A7A7A;">Marseille, Lille, Nantes, Strasbourg…</span></p></mj-text><mj-divider width="40px" border-width="1px" border-color="#DDD9D2" padding="18px 0"></mj-divider><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="18px" line-height="25px" color="#1E1E1E" padding="0 0 4px 0"><p style="margin:0;">Zone C</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#474747" padding="0"><p style="margin:0;">Du [[Dates de la zone C|3 au 19 avril]]<br/><span style="font-size:12px;color:#7A7A7A;">Paris, Toulouse, Montpellier…</span></p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="40px 56px 44px 56px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="17px" line-height="27px" font-style="italic" color="#1E1E1E" padding="0 0 18px 0"><p style="margin:0;">À très bientôt,<br/>[[Prénom du directeur|Claire]], et toute l'équipe de {{facility_name}}</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="21px" color="#7A7A7A" padding="0"><p style="margin:0;"><span style="color:#8C6B4A;letter-spacing:2px;">P.S.</span> Les chambres familiales partent en premier sur les deux semaines de votre zone : pensez à réserver tôt.</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E1E" padding="44px 40px 40px 40px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="18px" line-height="28px" font-style="italic" color="#EDEAE4" padding="0 0 26px 0"><p style="margin:0;">Réservez en direct : [[Votre avantage|le lit d'appoint offert]].</p></mj-text><mj-social icon-size="22px" mode="horizontal" padding="0 0 26px 0"><mj-social-element name="instagram" href="{{social_instagram}}" src="https://app.trigger-flow.com/socialIcons/dark/instagram.png" background-color="transparent" padding="0 8px"></mj-social-element><mj-social-element name="facebook" href="{{social_facebook}}" src="https://app.trigger-flow.com/socialIcons/dark/facebook.png" background-color="transparent" padding="0 8px"></mj-social-element><mj-social-element name="tripadvisor" href="{{social_tripadvisor}}" src="https://app.trigger-flow.com/socialIcons/dark/tripadvisor.png" background-color="transparent" padding="0 8px"></mj-social-element></mj-social><mj-divider width="40px" border-width="1px" border-color="#3A3A3A" padding="0 0 24px 0"></mj-divider><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="15px" letter-spacing="4px" color="#EDEAE4" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="12px" line-height="20px" color="#A6A29B" padding="0"><p style="margin:0;">{{facility_address}}, {{facility_zip_code}} {{facility_city}}<br/>{{facility_phone}} · {{facility_email}}</p></mj-text></mj-column></mj-section></mj-body></mjml>