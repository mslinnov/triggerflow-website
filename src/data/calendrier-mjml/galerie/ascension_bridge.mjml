<mjml><mj-head><!-- VISIBILITY_STYLES --><mj-style>
      /* Desktop-first : les clients qui ne supportent pas @media
         (Outlook Web, Nouveau Outlook) gardent le comportement desktop. */
      .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
        display: block;
        width: auto;
        max-height: none;
        overflow: visible;
        line-height: inherit;
      }
      .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
        display: none;
        width: 0;
        max-height: 0;
        overflow: hidden;
        line-height: 0;
      }
      /* Mobile : afficher mobile-only, masquer desktop-only */
      @media only screen and (max-width:599px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
      }
      /* Desktop explicit (pour spécificité) */
      @media only screen and (min-width:600px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
      /* Fallback : vrais appareils mobiles (Outlook mobile peut avoir un viewport &gt;600px) */
      @media only screen and (max-device-width:599px) {
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
    </mj-style><!--[if mso | IE]>
      <style type="text/css">
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        table.desktop-only, table.desktop-only-outlook, table[class*="desktop-only"],
        tr.desktop-only, tr.desktop-only-outlook, tr[class*="desktop-only"],
        td.desktop-only, td.desktop-only-outlook, td[class*="desktop-only"] {
          display: table !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        table.mobile-only, table.mobile-only-outlook, table[class*="mobile-only"],
        tr.mobile-only, tr.mobile-only-outlook, tr[class*="mobile-only"],
        td.mobile-only, td.mobile-only-outlook, td[class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      </style>
    <![endif]--><mj-attributes><mj-all padding="0">
            </mj-all></mj-attributes><mj-preview>Du jeudi au dimanche, le programme est prêt.</mj-preview></mj-head><mj-body background-color="#E9E6E0" width="640px"><mj-section background-color="#FFFFFF" padding="36px 24px 0 24px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="26px" line-height="32px" letter-spacing="5px" color="#1E1E1E" padding="0 0 24px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-divider border-width="1px" border-color="#DDD9D2" padding="0"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" line-height="20px" letter-spacing="2px" color="#1E1E1E" padding="11px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{booking_page_url}}" style="color:#1E1E1E;text-decoration:none;">Réserver</a><span style="color:#8C6B4A;">&nbsp;&nbsp;·&nbsp; </span><a href="{{website_url}}" style="color:#1E1E1E;text-decoration:none;">Nos&nbsp;offres</a><span style="color:#8C6B4A;">&nbsp;&nbsp;·&nbsp; </span><a href="{{website_url}}" style="color:#1E1E1E;text-decoration:none;">L'hôtel</a></p></mj-text><mj-divider border-width="1px" border-color="#DDD9D2" padding="0"></mj-divider></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="28px 40px 0 40px"><mj-group><mj-column width="33.33%" padding="0 5px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/sea-room-600.jpg" href="{{booking_page_url}}" alt="Quatre jours pour souffler" padding="0"></mj-image></mj-column><mj-column width="33.33%" padding="0 5px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/pool-square-600.jpg" href="{{booking_page_url}}" alt="Quatre jours pour souffler" padding="0"></mj-image></mj-column><mj-column width="33.33%" padding="0 5px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/sea-terrace-600.jpg" href="{{booking_page_url}}" alt="Quatre jours pour souffler" padding="0"></mj-image></mj-column></mj-group></mj-section><mj-section background-color="#FFFFFF" padding="48px 56px 52px 56px"><mj-column><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" letter-spacing="4px" color="#8C6B4A" padding="0 0 14px 0"><p style="margin:0;text-transform:uppercase;">Pont de l'Ascension</p></mj-text><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="30px" line-height="38px" color="#1E1E1E" padding="0 0 20px 0"><p style="margin:0;">Quatre jours pour souffler</p></mj-text><mj-divider width="48px" border-width="1px" border-color="#8C6B4A" padding="0 0 22px 0"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="15px" line-height="25px" color="#474747" padding="0 0 14px 0"><p style="margin:0 0 12px 0;">Bonjour {{firstname}},</p><p style="margin:0 0 12px 0;">Du [[Date de début|jeudi 6 mai]] au [[Date de fin|dimanche 9 mai]], le pont de l'Ascension offre quatre jours pour souffler. Nous avons préparé le programme, vous n'avez plus qu'à venir.</p></mj-text><mj-button href="{{booking_page_url}}" background-color="#8C6B4A" color="#FFFFFF" border-radius="0px" font-family="Helvetica, Arial, sans-serif" font-size="12px" letter-spacing="3px" text-transform="uppercase" inner-padding="16px 40px" padding="0">Je réserve le pont</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 56px 26px 56px"><mj-column><mj-divider border-width="1px" border-color="#DDD9D2" padding="0 0 40px 0"></mj-divider><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="24px" line-height="30px" color="#1E1E1E" padding="0"><p style="margin:0;">Votre pont, jour après jour</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 30px 8px 30px"><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/bar-600.jpg" href="{{booking_page_url}}" alt="Jeudi" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">Jeudi</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Programme|Verre de bienvenue]]</p></mj-text></mj-column><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/kids-600.jpg" href="{{booking_page_url}}" alt="Vendredi" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">Vendredi</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Programme|Balade et marché]]</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 30px 8px 30px"><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/spa-600.jpg" href="{{booking_page_url}}" alt="Samedi" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">Samedi</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Programme|Spa et dîner]]</p></mj-text></mj-column><mj-column width="50%" padding="0 10px 28px 10px"><mj-image src="https://api.trigger-flow.com/images/email-library/temps-forts/breakfast-600.jpg" href="{{booking_page_url}}" alt="Dimanche" padding="0"></mj-image><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="19px" line-height="25px" color="#1E1E1E" padding="18px 6px 6px 6px"><p style="margin:0;">Dimanche</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="10px" line-height="17px" letter-spacing="2px" color="#7A7A7A" padding="0 6px"><p style="margin:0;text-transform:uppercase;">[[Programme|Brunch et départ tardif]]</p></mj-text></mj-column></mj-section><mj-section background-color="#F6F4F0" padding="40px 40px 0 40px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="21px" line-height="28px" color="#1E1E1E" padding="0 0 26px 0"><p style="margin:0;">En réservant chez nous, en direct</p></mj-text></mj-column></mj-section><mj-section background-color="#F6F4F0" padding="0 28px 26px 28px"><mj-column width="33.33%" padding="0 12px 18px 12px"><mj-divider width="28px" border-width="1px" border-color="#8C6B4A" padding="0 0 14px 0"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#474747" padding="0"><p style="margin:0;">[[Avantage|Le départ tardif le dimanche]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 12px 18px 12px"><mj-divider width="28px" border-width="1px" border-color="#8C6B4A" padding="0 0 14px 0"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#474747" padding="0"><p style="margin:0;">[[Avantage|Le petit-déjeuner offert]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 12px 18px 12px"><mj-divider width="28px" border-width="1px" border-color="#8C6B4A" padding="0 0 14px 0"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#474747" padding="0"><p style="margin:0;">[[Avantage|L'accès au spa compris]]</p></mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="40px 56px 44px 56px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="17px" line-height="27px" font-style="italic" color="#1E1E1E" padding="0 0 18px 0"><p style="margin:0;">À très bientôt,<br/>[[Prénom du directeur|Claire]], et toute l'équipe de {{facility_name}}</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="21px" color="#7A7A7A" padding="0"><p style="margin:0;"><span style="color:#8C6B4A;letter-spacing:2px;">P.S.</span> Les chambres partent vite sur ces dates : il nous en reste [[Nombre de chambres|8]].</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E1E" padding="44px 40px 40px 40px"><mj-column><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="18px" line-height="28px" font-style="italic" color="#EDEAE4" padding="0 0 26px 0"><p style="margin:0;">Réservez en direct : [[Votre avantage|le départ tardif offert]].</p></mj-text><mj-social icon-size="22px" mode="horizontal" padding="0 0 26px 0"><mj-social-element name="instagram" href="{{social_instagram}}" src="https://app.trigger-flow.com/socialIcons/dark/instagram.png" background-color="transparent" padding="0 8px"></mj-social-element><mj-social-element name="facebook" href="{{social_facebook}}" src="https://app.trigger-flow.com/socialIcons/dark/facebook.png" background-color="transparent" padding="0 8px"></mj-social-element><mj-social-element name="tripadvisor" href="{{social_tripadvisor}}" src="https://app.trigger-flow.com/socialIcons/dark/tripadvisor.png" background-color="transparent" padding="0 8px"></mj-social-element></mj-social><mj-divider width="40px" border-width="1px" border-color="#3A3A3A" padding="0 0 24px 0"></mj-divider><mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="15px" letter-spacing="4px" color="#EDEAE4" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="12px" line-height="20px" color="#A6A29B" padding="0"><p style="margin:0;">{{facility_address}}, {{facility_zip_code}} {{facility_city}}<br/>{{facility_phone}} · {{facility_email}}</p></mj-text></mj-column></mj-section></mj-body></mjml>