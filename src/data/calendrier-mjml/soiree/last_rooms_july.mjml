<mjml><mj-head><!-- VISIBILITY_STYLES --><mj-style>
      /* Desktop-first : les clients qui ne supportent pas @media
         (Outlook Web, Nouveau Outlook) gardent le comportement desktop. */
      .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
        display: block;
        width: auto;
        max-height: none;
        overflow: visible;
        line-height: inherit;
      }
      .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
        display: none;
        width: 0;
        max-height: 0;
        overflow: hidden;
        line-height: 0;
      }
      /* Mobile : afficher mobile-only, masquer desktop-only */
      @media only screen and (max-width:599px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
      }
      /* Desktop explicit (pour spécificité) */
      @media only screen and (min-width:600px) {
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
      /* Fallback : vrais appareils mobiles (Outlook mobile peut avoir un viewport &gt;600px) */
      @media only screen and (max-device-width:599px) {
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      }
    </mj-style><!--[if mso | IE]>
      <style type="text/css">
        .desktop-only, .desktop-only-outlook, [class*="desktop-only"] {
          display: block !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        .mobile-only, .mobile-only-outlook, [class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
        table.desktop-only, table.desktop-only-outlook, table[class*="desktop-only"],
        tr.desktop-only, tr.desktop-only-outlook, tr[class*="desktop-only"],
        td.desktop-only, td.desktop-only-outlook, td[class*="desktop-only"] {
          display: table !important;
          width: auto !important;
          max-height: none !important;
          overflow: visible !important;
          line-height: inherit !important;
          mso-hide: none !important;
        }
        table.mobile-only, table.mobile-only-outlook, table[class*="mobile-only"],
        tr.mobile-only, tr.mobile-only-outlook, tr[class*="mobile-only"],
        td.mobile-only, td.mobile-only-outlook, td[class*="mobile-only"] {
          display: none !important;
          width: 0 !important;
          max-height: 0 !important;
          overflow: hidden !important;
          line-height: 0 !important;
          mso-hide: all !important;
        }
      </style>
    <![endif]--><mj-attributes><mj-all padding="0">
            </mj-all></mj-attributes><mj-preview>Les dernières dates, à saisir en direct.</mj-preview></mj-head><mj-body background-color="#161618" width="640px"><mj-section background-color="#1E1E21" padding="28px 20px 8px 20px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="24px" letter-spacing="3px" color="#F3EFEA" padding="0 0 14px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-divider border-width="1px" border-color="#3E3E44" padding="0 60px"></mj-divider><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" line-height="20px" letter-spacing="1px" color="#F3EFEA" padding="12px 0 6px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{website_url}}" style="color:#F3EFEA;text-decoration:none;">Chambres</a><span style="color:#BDB6AE;">&nbsp;· </span><a href="{{website_url}}" style="color:#F3EFEA;text-decoration:none;">Restaurant</a><span style="color:#BDB6AE;">&nbsp;· </span><a href="{{website_url}}" style="color:#F3EFEA;text-decoration:none;">Bons&nbsp;cadeaux</a><span style="color:#BDB6AE;">&nbsp;· </span><a href="{{booking_page_url}}" style="color:#F3EFEA;text-decoration:none;">Réserver</a></p></mj-text></mj-column></mj-section><mj-hero mode="fixed-height" height="440px" background-width="640px" background-height="440px" background-url="https://api.trigger-flow.com/storage/files/file_AXLPqoCB210XXr8m.png" background-color="#F3EFEA" background-position="center center" padding="150px 40px 40px 40px"><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="12px" letter-spacing="4px" color="#FFFFFF" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;text-shadow:0 1px 6px rgba(0,0,0,0.6);">Dernières chambres</p></mj-text><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="34px" line-height="40px" color="#FFFFFF" padding="0 0 24px 0"><p style="margin:0;"><span style="background-color:rgba(0,0,0,0.38);padding:4px 14px;line-height:52px;-webkit-box-decoration-break:clone;box-decoration-break:clone;text-shadow:0 2px 10px rgba(0,0,0,0.5);">Il nous reste quelques chambres</span></p></mj-text><mj-button href="{{booking_page_url}}" background-color="#F3EFEA" color="#161618" border-radius="40px" font-family="Helvetica, Arial, sans-serif" font-size="12px" font-weight="bold" letter-spacing="2px" text-transform="uppercase" inner-padding="14px 30px" padding="0">Voir les dernières chambres</mj-button></mj-hero><mj-section background-color="#1E1E21" padding="40px 48px 16px 48px"><mj-column><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="16px" line-height="26px" color="#F3EFEA" padding="0"><p style="margin:0 0 14px 0;">Bonjour {{firstname}},</p><p style="margin:0 0 14px 0;">L'été approche et nos chambres trouvent preneur. Il en reste encore quelques-unes, du [[Dates disponibles|12 au 26 juillet]]. Si vous hésitiez, c'est le moment.</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E21" padding="24px 48px 24px 48px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="26px" line-height="32px" color="#F3EFEA" padding="0 0 18px 0"><p style="margin:0;">Ce qui reste disponible</p></mj-text><mj-text padding="0"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-top:1px solid #3E3E44;"><tr><td valign="top" style="padding:14px 16px 14px 0;border-bottom:1px solid #3E3E44;width:36%;font-family:Georgia, 'Times New Roman', serif;font-size:17px;line-height:24px;color:#F3EFEA;">[[Catégorie|Chambre double vue jardin]]</td><td valign="top" style="padding:14px 0;border-bottom:1px solid #3E3E44;font-family:Helvetica, Arial, sans-serif;font-size:14px;line-height:22px;color:#F3EFEA;">Du [[Dates|12 au 19 juillet]]<br/><span style="font-size:12px;color:#BDB6AE;">À partir de [[Prix|140 €]] la nuit</span></td></tr><tr><td valign="top" style="padding:14px 16px 14px 0;border-bottom:1px solid #3E3E44;width:36%;font-family:Georgia, 'Times New Roman', serif;font-size:17px;line-height:24px;color:#F3EFEA;">[[Catégorie|Suite familiale]]</td><td valign="top" style="padding:14px 0;border-bottom:1px solid #3E3E44;font-family:Helvetica, Arial, sans-serif;font-size:14px;line-height:22px;color:#F3EFEA;">Du [[Dates|20 au 26 juillet]]<br/><span style="font-size:12px;color:#BDB6AE;">À partir de [[Prix|230 €]] la nuit</span></td></tr><tr><td valign="top" style="padding:14px 16px 14px 0;border-bottom:1px solid #3E3E44;width:36%;font-family:Georgia, 'Times New Roman', serif;font-size:17px;line-height:24px;color:#F3EFEA;">[[Catégorie|Chambre vue mer]]</td><td valign="top" style="padding:14px 0;border-bottom:1px solid #3E3E44;font-family:Helvetica, Arial, sans-serif;font-size:14px;line-height:22px;color:#F3EFEA;">[[Dates|Quelques nuits isolées]]<br/><span style="font-size:12px;color:#BDB6AE;">À partir de [[Prix|180 €]] la nuit</span></td></tr></table></mj-text></mj-column></mj-section><mj-section background-color="#1E1E21" padding="36px 32px 0 32px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="26px" line-height="32px" color="#F3EFEA" padding="0 0 18px 0"><p style="margin:0;">En réservant chez nous, en direct</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E21" padding="8px 22px 20px 22px"><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C9A464" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#F3EFEA" padding="0 0 16px 0"><p style="margin:0;">[[Avantage|Le petit-déjeuner offert]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C9A464" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#F3EFEA" padding="0 0 16px 0"><p style="margin:0;">[[Avantage|Le parking compris]]</p></mj-text></mj-column><mj-column width="33.33%" padding="0 10px"><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="22px" color="#C9A464" padding="0 0 6px 0"><p style="margin:0;">&#10022;</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="21px" color="#F3EFEA" padding="0 0 16px 0"><p style="margin:0;">[[Avantage|L'arrivée anticipée selon disponibilité]]</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E21" padding="28px 32px 4px 32px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="26px" line-height="32px" color="#F3EFEA" padding="0 0 18px 0"><p style="margin:0;">Votre été chez nous</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E21" padding="0 32px 24px 32px"><mj-column width="50%" vertical-align="middle" background-color="#26262A" padding="14px"><mj-image src="https://api.trigger-flow.com/storage/files/file_xoc893wyP7FACtFV.png" alt="La piscine" padding="0" width="260px"></mj-image></mj-column><mj-column width="50%" vertical-align="middle" padding="12px 24px"><mj-text font-family="Helvetica, Arial, sans-serif" font-size="12px" letter-spacing="3px" color="#D8D2CA" padding="0 0 8px 0"><p style="margin:0;text-transform:uppercase;">La piscine</p></mj-text><mj-text font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#F3EFEA" padding="0"><p style="margin:0;">[[Ce qui vous attend|Des transats à l'ombre des pins, du matin au soir.]]</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E21" padding="0 32px 24px 32px" direction="rtl"><mj-column width="50%" vertical-align="middle" background-color="#26262A" padding="14px"><mj-image src="https://api.trigger-flow.com/storage/files/file_MTnkcAoHYBbubP8k.png" alt="La terrasse" padding="0" width="260px"></mj-image></mj-column><mj-column width="50%" vertical-align="middle" padding="12px 24px"><mj-text font-family="Helvetica, Arial, sans-serif" font-size="12px" letter-spacing="3px" color="#D8D2CA" padding="0 0 8px 0"><p style="margin:0;text-transform:uppercase;">La terrasse</p></mj-text><mj-text font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#F3EFEA" padding="0"><p style="margin:0;">[[Ce qui vous attend|Un dîner face à la mer quand la chaleur retombe.]]</p></mj-text></mj-column></mj-section><mj-section background-color="#1E1E21" padding="8px 48px 40px 48px"><mj-column><mj-divider border-width="1px" border-color="#3E3E44" padding="0 0 24px 0"></mj-divider><mj-text font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="17px" line-height="26px" font-style="italic" color="#F3EFEA" padding="0 0 18px 0"><p style="margin:0;">À très bientôt,<br/>[[Prénom du directeur|Claire]], et toute l'équipe de {{facility_name}}</p></mj-text><mj-text font-family="Helvetica, Arial, sans-serif" font-size="14px" line-height="22px" color="#BDB6AE" padding="0"><p style="margin:0;"><strong style="color:#D8D2CA;">P.S.</strong> Ce sont vraiment les dernières : à cette date, il nous en reste [[Nombre de chambres|5]].</p></mj-text></mj-column></mj-section><mj-section background-color="#161618" padding="32px 24px 36px 24px"><mj-column><mj-text align="center" font-family="Georgia, &#039;Times New Roman&#039;, serif" font-size="18px" letter-spacing="2px" color="#F3EFEA" padding="0 0 10px 0"><p style="margin:0;text-transform:uppercase;">{{facility_name}}</p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="11px" line-height="20px" letter-spacing="1px" color="#BDB6AE" padding="0 0 12px 0"><p style="margin:0;text-transform:uppercase;"><a href="{{booking_page_url}}" style="color:#BDB6AE;text-decoration:none;">Séjours</a>&nbsp;· <a href="{{website_url}}" style="color:#BDB6AE;text-decoration:none;">Restaurant</a>&nbsp;· <a href="{{website_url}}" style="color:#BDB6AE;text-decoration:none;">Séminaires</a>&nbsp;· <a href="{{website_url}}" style="color:#BDB6AE;text-decoration:none;">Bons&nbsp;cadeaux</a></p></mj-text><mj-text align="center" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="20px" color="#BDB6AE" padding="0 0 12px 0"><p style="margin:0;">{{facility_address}}, {{facility_zip_code}} {{facility_city}}<br/>{{facility_phone}} · {{facility_email}}</p></mj-text><mj-social font-size="12px" icon-size="28px" border-radius="80px" mode="horizontal" padding="4px 0 0 0"><mj-social-element name="instagram" href="{{social_instagram}}" src="https://app.trigger-flow.com/socialIcons/light/instagram.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="facebook" href="{{social_facebook}}" src="https://app.trigger-flow.com/socialIcons/light/facebook.png" background-color="transparent" padding="0 6px"></mj-social-element><mj-social-element name="tripadvisor" href="{{social_tripadvisor}}" src="https://app.trigger-flow.com/socialIcons/light/tripadvisor.png" background-color="transparent" padding="0 6px"></mj-social-element></mj-social></mj-column></mj-section></mj-body></mjml>