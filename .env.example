# Google Analytics measurement ID (G-XXXXXXXXXX)
# Public — exposed client-side. If unset, the GoogleAnalytics
# component does nothing and the cookie banner offers no analytics
# toggle effect. Must be defined at BUILD TIME (NEXT_PUBLIC_* are
# baked into the bundle by Next.js), so set it in your hosting
# environment before running `npm run build`.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Consent Mode strategy: 'advanced' (default) or 'basic'.
#   advanced — gtag.js loads for everyone, consent defaults to denied,
#              non-consenting visitors send cookieless pings that GA4 models.
#              Best measurement; relies on the EU-US Data Privacy Framework.
#   basic    — gtag.js is withheld until consent is granted. Zero data sent to
#              Google before consent (strictest CNIL reading); only consenting
#              visitors are measured, no modeling.
# Also baked in at BUILD TIME. Leave unset to use 'advanced'.
NEXT_PUBLIC_GA_CONSENT_MODE=advanced

# Meta (Facebook) pixel ID — public, exposed client-side.
# If unset, the MetaPixel component does nothing and the cookie banner still
# offers the advertising category (it simply has nothing to load).
# The pixel only fires once the visitor grants the "marketing" consent category.
NEXT_PUBLIC_META_PIXEL_ID=

# Brevo — liste dédiée aux leads des landing pages d'acquisition (/api/leads).
# Liste « LP Acquisition - Leads upsell (FB Ads) », dossier Contacts TriggerFlow.
BREVO_LEADS_LIST_ID=21

# Adresse recevant la notification interne à chaque nouveau lead.
LEADS_NOTIFICATION_EMAIL=
